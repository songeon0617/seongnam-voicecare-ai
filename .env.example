# Server-only. Copy to .env.local; never use NEXT_PUBLIC_ for these values.
# Disabled by default. All three values are needed to call the provider.
PUBLIC_INFORMATION_AI_ENABLED=false
OPENAI_API_KEY=
# Choose an accessible model that supports Responses API + Structured Outputs.
OPENAI_MODEL=

# Emergency OFF by default. Runtime web search requires an existing key/model AND a budget.
PUBLIC_INFORMATION_WEB_SEARCH_ENABLED=false
# Per-process admission estimate only, max $3/UTC day and 20 requests; not a global spend cap.
PUBLIC_INFORMATION_SEARCH_DAILY_USD=0
